diff --git a/src/build/LibtoolStep.zig b/src/build/LibtoolStep.zig
index d2b5149..fceaf3a 100644
--- a/src/build/LibtoolStep.zig
+++ b/src/build/LibtoolStep.zig
@@ -31,7 +31,27 @@ pub fn create(b: *std.Build, opts: Options) *LibtoolStep {
     const self = b.allocator.create(LibtoolStep) catch @panic("OOM");
 
     const run_step = RunStep.create(b, b.fmt("libtool {s}", .{opts.name}));
-    run_step.addArgs(&.{ "libtool", "-static", "-o" });
+    // Seance: newer Apple libtool rejects archive members that are not
+    // 8-byte aligned (as written by zig's archiver), silently dropping them.
+    // Extract every input archive and re-archive the raw objects instead.
+    run_step.addArgs(&.{ "/bin/sh", "-c",
+        \\set -e
+        \\out="$1"; shift
+        \\tmp=$(mktemp -d)
+        \\i=0
+        \\for a in "$@"; do
+        \\  i=$((i+1)); d="$tmp/$i"; mkdir -p "$d"
+        \\  abs="$(cd "$(dirname "$a")" && pwd)/$(basename "$a")"
+        \\  case "$abs" in
+        \\    *.o) cp "$abs" "$d/" ;;
+        \\    *) (cd "$d" && ar x "$abs") ;;
+        \\  esac
+        \\  chmod -R u+rw "$d"
+        \\done
+        \\find "$tmp" -name '*.o' | sort > "$tmp/objs.txt"
+        \\libtool -static -o "$out" -filelist "$tmp/objs.txt"
+        \\rm -rf "$tmp"
+    , "libtool" });
     const output = run_step.addOutputFileArg(opts.out_name);
     for (opts.sources) |source| run_step.addFileArg(source);
 
